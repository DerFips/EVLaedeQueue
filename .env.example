# ---- App ----
APP_NAME=EVLädeQueue
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
APP_BASE_URL=http://localhost:8000

# ---- JWT ----
JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14

# ---- Database ----
DATABASE_URL=sqlite:///./data/ladeplatz.db

# ---- SMTP (E-Mail Benachrichtigung) ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USE_TLS=true

# ---- CORS (fuer mobile App) ----
CORS_ALLOWED_ORIGINS=http://localhost:3000,capacitor://localhost

# ---- Admin Bootstrap (nur beim ersten Start verwendet) ----
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_strong_password
